    {
      "id": 2001,
      "type": "row",
      "title": "Detailed Port Configuration",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 2000,
          "type": "marcusolsson-dynamictext-panel",
          "title": "",
          "gridPos": {
            "x": 0,
            "y": 16,
            "w": 24,
            "h": 14
          },
          "targets": [
            {
              "expr": "switch_port_up{host=\"Christina\"}",
              "instant": true,
              "format": "table",
              "refId": "A"
            }
          ],
          "options": {
            "content": "\n<style>\n  .pg-wrap    { padding:0; color:#e6edf3; font-family:'Inter',sans-serif; overflow:visible; }\n  .pg-hdr     { display:flex; justify-content:flex-start; align-items:center; margin-bottom:10px; }\n  .pg-legend  { font-size:12px; color:#8899a8; display:flex; gap:14px; align-items:center; flex-wrap:wrap; }\n  .pg-legend .swatch { display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:5px; vertical-align:middle; }\n  .pg-section { margin-bottom:12px; }\n  .pg-shdr    { color:#7ec8ff; font:600 15px 'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.7px; margin-bottom:6px; padding-bottom:5px; border-bottom:1px solid #2a3038; display:flex; justify-content:space-between; align-items:baseline; }\n  .pg-shdr .count { color:#8899a8; font-size:13px; font-weight:400; }\n  .pg-cards   { display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:6px; }\n  .pcard      { background:#161a20; border:1px solid #2a3038; border-radius:5px; padding:6px 9px; border-left-width:3px; }\n  .pcard-hd   { display:flex; justify-content:space-between; align-items:center; }\n  .pcard-num  { font:700 14px monospace; color:#e6edf3; }\n  .pcard-dot  { width:11px; height:11px; border-radius:50%; }\n  .pcard-dev  { color:#9daab6; font:500 13px 'Inter',sans-serif; margin-top:2px; min-height:14px; }\n  .pcard-chips{ display:flex; gap:4px; margin-top:4px; flex-wrap:wrap; min-height:0; }\n  .chip       { padding:2px 7px; border-radius:3px; font:600 12px monospace; letter-spacing:0.3px; }\n  .chip-vlan  { background:#1e3a4d; color:#7fbfff; }\n  .chip-fec   { background:#2f2035; color:#c7a8ff; }\n  .chip-flow  { background:#1e3a2f; color:#7fdca8; }\n  :host, div[class*=\"panel-content\"], div[class*=\"scroll\"] { overflow:visible !important; max-height:none !important; }\n</style>\n<div class=\"pg-wrap\">\n  <div class=\"pg-hdr\">\n    <div class=\"pg-legend\">\n      <span><span class=\"swatch\" style=\"background:#37872d\"></span>up</span>\n      <span><span class=\"swatch\" style=\"background:#dfa817\"></span>idle</span>\n      <span><span class=\"swatch\" style=\"background:#8a1a1a\"></span>down</span>\n      <span><span class=\"swatch\" style=\"background:#3a4550\"></span>empty</span>\n    </div>\n  </div>\n  {{{renderGroups data}}}\n</div>\n",
            "defaultContent": "loading port configuration\u2026",
            "renderMode": "allRowsOrFirst",
            "everyRow": false,
            "editor": {
              "format": "auto",
              "language": "html"
            },
            "helpers": "\nvar FPGA_PORTS = {'100ge1/0/9':1,'100ge1/0/10':1,'100ge1/0/11':1,'100ge1/0/12':1,'100ge1/0/15':1};\nvar PORT_INFO = {\n  '100ge1/0/7':  'Amy \u00b7 E810',\n  '100ge1/0/12': 'Amy \u00b7 U280',\n  '10ge1/0/33':  'Amy \u00b7 BCM mgmt',\n  '100ge1/0/8':  'Clara \u00b7 E810',\n  '100ge1/0/11': 'Clara \u00b7 U280',\n  '10ge1/0/34':  'Clara \u00b7 BCM mgmt',\n  '100ge1/0/16': 'Rose \u00b7 E810',\n  '100ge1/0/9':  'Rose \u00b7 U280',\n  '100ge1/0/15': 'Rose \u00b7 V80',\n  '100ge1/0/10': 'Momiji \u00b7 U280',\n  'mgt-eth0/0/0':'Switch mgmt'\n};\n\nfunction stateColor(r) {\n  if (!r) return '#3a4550';\n  if ((+r.Value) > 0) return '#37872d';\n  return FPGA_PORTS[r.port] ? '#dfa817' : '#8a1a1a';\n}\nfunction stateLabel(r) {\n  if (!r) return '\u2014';\n  if ((+r.Value) > 0) return 'up';\n  return FPGA_PORTS[r.port] ? 'idle' : 'down';\n}\nfunction esc(s) { return String(s).replace(/[<>&\"']/g, function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',\"'\":'&#39;'}[c];}); }\nfunction chips(r) {\n  var out = '';\n  if (r.config_vlan && r.config_vlan !== '1')       out += '<span class=\"chip chip-vlan\">v' + esc(r.config_vlan) + '</span>';\n  if (r.fec && r.fec !== 'none')                    out += '<span class=\"chip chip-fec\">'  + esc(r.fec) + '</span>';\n  if (r.flow_control === 'enabled')                 out += '<span class=\"chip chip-flow\">flow</span>';\n  return out;\n}\nfunction renderCard(r, deviceLabel) {\n  var color = stateColor(r);\n  return '<div class=\"pcard\" style=\"border-left-color:' + color + ';\">'\n    +   '<div class=\"pcard-hd\"><span class=\"pcard-num\">' + esc(r.port) + '</span>'\n    +     '<span class=\"pcard-dot\" style=\"background:' + color + ';\" title=\"' + stateLabel(r) + '\"></span></div>'\n    +   '<div class=\"pcard-dev\">' + esc(deviceLabel || '') + '</div>'\n    +   '<div class=\"pcard-chips\">' + chips(r) + '</div></div>';\n}\n\ncontext.handlebars.registerHelper('renderGroups', function(rows) {\n  if (!Array.isArray(rows)) return '';\n  var populated = [], empty = [];\n  rows.forEach(function(r) {\n    var dev = PORT_INFO[r.port];\n    if (dev)                { populated.push({r: r, dev: dev}); return; }\n    if ((+r.Value) > 0)     { populated.push({r: r, dev: 'unknown link partner'}); return; }\n    empty.push({r: r, dev: ''});\n  });\n  function byNum(a,b) {\n    var an = parseInt((a.r.port.match(/(\\d+)$/) || [0,0])[1], 10);\n    var bn = parseInt((b.r.port.match(/(\\d+)$/) || [0,0])[1], 10);\n    return an - bn;\n  }\n  populated.sort(byNum); empty.sort(byNum);\n\n  function section(name, arr) {\n    if (!arr.length) return '';\n    return '<div class=\"pg-section\">'\n         +   '<div class=\"pg-shdr\">' + name + ' <span class=\"count\">' + arr.length + '</span></div>'\n         +   '<div class=\"pg-cards\">' + arr.map(function(x){ return renderCard(x.r, x.dev); }).join('') + '</div>'\n         + '</div>';\n  }\n  return section('Populated', populated) + section('Empty', empty);\n});\n"
          },
          "transparent": true
        }
      ]
    }
  ],
